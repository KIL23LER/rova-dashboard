# ═══════════════════════════════════════════════════════════════════
#   Rova Bot v5.0 ULTRA — Environment Variables
#   انسخ هذا الملف إلى .env أو أضف المتغيرات في WispByte → Variables
# ═══════════════════════════════════════════════════════════════════

# ─── مطلوب بالكامل (Required) ─────────────────────────────────────

# توكن البوت — من Discord Developer Portal → Bot → Token
DISCORD_BOT_TOKEN=your_bot_token_here

# Client ID — من Discord Developer Portal → General Information
DISCORD_CLIENT_ID=your_client_id_here

# Client Secret — من Discord Developer Portal → OAuth2 → Client Secret
DISCORD_CLIENT_SECRET=your_client_secret_here

# ─── Dashboard ────────────────────────────────────────────────────

# رابط الداشبورد على Vercel (بدون / في النهاية)
DASHBOARD_URL=https://rova-dashboard-pearl.vercel.app

# ─── API Server ───────────────────────────────────────────────────

# الرابط الخارجي لـ API الخاص بك من WispByte (Network tab)
# يُستخدم لـ OAuth callback — مطلوب
API_URL=https://your-wispbyte-subdomain.wisp.gg

# البورت الداخلي للـ API (اتركه 8080 عادةً)
API_PORT=8080

# ─── Database ─────────────────────────────────────────────────────

# مسار قاعدة البيانات (اتركه كما هو)
BOT_DB_PATH=data/rova.db

# ─── Production ───────────────────────────────────────────────────
NODE_ENV=production

# ─── ملاحظة مهمة ──────────────────────────────────────────────────
# بعد إضافة المتغيرات، اذهب إلى:
# Discord Developer Portal → OAuth2 → Redirects
# وأضف: https://your-wispbyte-subdomain.wisp.gg/api/auth/callback
