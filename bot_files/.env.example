# ─── Rova Bot v4.0 ULTRA — Environment Variables ──────────────────────────────
# انسخ هذا الملف لـ .env أو أضفه في WispByte: Startup → Variables

# ─── مطلوب (Required) ─────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_CLIENT_SECRET=your_client_secret_here

# ─── Dashboard ─────────────────────────────────────────────────────────────────
# رابط الداشبورد على Vercel
DASHBOARD_URL=https://your-dashboard.vercel.app

# ─── API Server ────────────────────────────────────────────────────────────────
# الرابط الخارجي لـ API من WispByte (Network tab) — مطلوب للـ OAuth callback
API_URL=https://your-wispbyte-api-url.com
API_PORT=8080

# ─── Database ──────────────────────────────────────────────────────────────────
BOT_DB_PATH=data/rova.db

# ─── Production ────────────────────────────────────────────────────────────────
NODE_ENV=production
