# ─── Rova Bot v4.0 ULTRA — Environment Variables ──────────────────────────────
# أضف هذه المتغيرات في WispByte: Startup → Variables

# ─── مطلوب (Required) ─────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_CLIENT_SECRET=your_client_secret_here

# ─── Dashboard ─────────────────────────────────────────────────────────────────
# رابط الـ dashboard على Vercel (مطلوب للـ OAuth)
DASHBOARD_URL=https://your-dashboard.vercel.app

# ─── API Server ────────────────────────────────────────────────────────────────
# البورت اللي يشتغل عليه الـ API (WispByte يعطيك رابط خارجي)
API_PORT=8080

# ─── Database ──────────────────────────────────────────────────────────────────
BOT_DB_PATH=data/rova.db

# ─── Production ────────────────────────────────────────────────────────────────
NODE_ENV=production
